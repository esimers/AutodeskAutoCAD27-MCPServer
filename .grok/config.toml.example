# Optional project-scoped example. Prefer user-scope registration so the
# server works from every folder:
#   venv/Scripts/python.exe scripts/register_grok.py
#
# If you copy this file to config.toml, replace ROOT with this clone's
# absolute path. Forward slashes work on Windows.
# Example: C:/work/AutodeskAutoCAD27-MCPServer

[mcp_servers.autocad-sdk]
command = "ROOT/venv/Scripts/python.exe"
args = ["-u", "ROOT/server/mcp_server.py", "--source", "arxmgd"]
enabled = true
startup_timeout_sec = 180
env = { PYTHONPATH = "ROOT", PYTHONUNBUFFERED = "1" }
